{
  "name": "orbit",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "env:init": "node scripts/init-env.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check",
    "format": "biome format --write",
    "db:generate": "pnpm --filter @orbit/db generate",
    "db:migrate": "pnpm --filter @orbit/db migrate",
    "user:create": "pnpm --filter @orbit/api user:create",
    "user:password": "pnpm --filter @orbit/api user:password"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3"
  }
}

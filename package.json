{
  "name": "mail",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check",
    "format": "biome format --write",
    "db:generate": "pnpm --filter @mail/db generate",
    "db:migrate": "pnpm --filter @mail/db migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3"
  }
}

# 送信用に受け取った添付ファイルの置き場 (ATTACHMENTS_DIR の既定値)
/data

# 本番のバックアップの書き出し先
/deploy/backups

# 中継用のサーバーとの間の HTTPS に使う証明書と秘密鍵 (deploy/setup.sh が作る)
/deploy/certs

# 画面の自動更新の署名の秘密鍵 (deploy/app-update-key.sh が作る)
/deploy/secrets

# アプリ本体の配布用のファイル (deploy/deploy.sh が GitHub Releases から取り込む)
/deploy/app-releases

# 自動更新の記録 (deploy/update.sh)
/deploy/.update-state

# pdf.js のワーカーや CMap など (apps/web/scripts/copy-pdfjs.mjs が node_modules から写す)
/apps/web/public/pdfjs

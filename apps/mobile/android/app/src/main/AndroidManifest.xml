<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Orbit のアプリどうし (Mail、Calendar、Contacts) で、接続先サーバーとログインを共有する。
        signature なので、同じ鍵で署名したアプリだけがこの権限を持てる。しくみは SharedConfig.java。
    -->
    <permission
        android:name="jp.lunaproject.orbit.permission.SHARED_CONFIG"
        android:protectionLevel="signature" />
    <uses-permission android:name="jp.lunaproject.orbit.permission.SHARED_CONFIG" />

    <!-- ほかの Orbit のアプリの設定を読むために、相手が見えるようにする (Android 11 以降)。 -->
    <queries>
        <package android:name="jp.lunaproject.orbit.calendar" />
        <package android:name="jp.lunaproject.orbit.contacts" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                アプリ専用の URL (jp.lunaproject.orbit.mail://oauth/…)。
                外のブラウザーでの Google / Microsoft のログインから、アプリへ戻るときに使う。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" android:host="oauth" />
            </intent-filter>

        </activity>

        <!-- 新着メールの通知 (FCM)。アイコン、色、通知の分類の既定値。 -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_mail" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/brand" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/channel_new_mail_id" />

        <!--
            新着メールの知らせ (FCM) の受け口。ボタン付きの通知を組み立てるため、
            プッシュ通知のプラグインの受け口を、それを引き継いだこのアプリのものに置き換える。
        -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".OrbitMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 通知のボタン (既読にする、アーカイブなど) が押されたときの処理。 -->
        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false" />

        <!-- 予定の通知 (段取り 9)。招待の出欠ボタン (参加 / 未定 / 不参加) が押されたときの処理。 -->
        <receiver
            android:name=".EventActionReceiver"
            android:exported="false" />

        <!-- 予約したリマインダーの時刻が来たとき (AlarmManager から。ReminderScheduler)。 -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!--
            再起動・アプリの更新・時計やタイムゾーンの変更のあとに、リマインダーを登録し直す。
            受け取るのは Android だけが送れる知らせなので、exported でもほかのアプリからは呼べない。
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 接続先サーバーとログインを、同じ鍵で署名した Orbit のアプリへ公開する (読み取り専用)。 -->
        <provider
            android:name=".SharedConfigProvider"
            android:authorities="${applicationId}.shared"
            android:exported="true"
            android:permission="jp.lunaproject.orbit.permission.SHARED_CONFIG" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13 以降で通知を出すための許可 (利用者が通知を有効にしたときに尋ねる)。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 予定のリマインダーを、電源を入れ直したあとにも登録し直すため (BootReceiver)。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        正確なアラームの権限は、Mail アプリには付けない (Google Play の方針で USE_EXACT_ALARM は
        アラーム・カレンダーのアプリに限られる)。リマインダーは不正確なアラーム + サーバーの FCM で鳴らす。
        段取り 10 の Calendar アプリは USE_EXACT_ALARM を付ける (ReminderScheduler はそのまま使える)。
    -->
</manifest>

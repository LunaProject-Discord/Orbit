{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit",
  "version": "../package.json",
  "identifier": "jp.lunaproject.orbit",
  "build": {
    "beforeDevCommand": "pnpm --filter @orbit/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @orbit/web build",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Orbit Mail",
        "width": 1280,
        "height": 800,
        "minWidth": 380,
        "minHeight": 520,
        "decorations": false,
        "shadow": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,ElasticOverscroll"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["jp.lunaproject.orbit.mail"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "メール・カレンダー・連絡先を、複数の端末でリアルタイムに同期する Orbit のデスクトップ版",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "template": "windows/installer.nsi",
        "installerHooks": "windows/orbit.nsh",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["Japanese", "English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "ja-JP",
        "upgradeCode": "6815fd62-db8e-5d18-a07e-da487b7c2411"
      }
    },
    "publisher": "Luna Project",
    "copyright": "© Luna Project",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/orbit.desktop",
        "provides": ["orbit-mail"],
        "conflicts": ["orbit-mail"],
        "replaces": ["orbit-mail"]
      },
      "rpm": {
        "desktopTemplate": "linux/orbit.desktop",
        "provides": ["orbit-mail"],
        "obsoletes": ["orbit-mail"]
      }
    }
  }
}

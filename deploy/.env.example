# 本番 (Oracle Cloud) 用の設定。deploy/setup.sh がこのファイルから deploy/.env を作る。
# 手順は docs/deploy-oracle-cloud.md を参照。

# 公開するドメイン (https:// は付けない)。Web も API もこのドメインで公開する
DOMAIN=mail.example.com

# 下の 3 つは deploy/setup.sh が自動で生成する
# PostgreSQL のパスワード。最初の起動後に変えても DB 側には反映されない
POSTGRES_PASSWORD=
# ログインセッションの署名に使う秘密の値
BETTER_AUTH_SECRET=
# メールアカウントの認証情報を暗号化する鍵 (base64 の 32 バイト)。
# 失うと保存済みの認証情報を復号できなくなるので、サーバーの外にも控えておくこと
CREDENTIALS_ENCRYPTION_KEY=

# Microsoft アカウント (Exchange Online / Outlook.com) の追加。空のままなら無効。
# Entra のアプリ登録のリダイレクト URI は https://<DOMAIN>/oauth/microsoft にする
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Web 以外から API を使うときに許可するオリジン (カンマ区切り)。
# 例: Tauri のデスクトップ版なら tauri://localhost,http://tauri.localhost
EXTRA_ALLOWED_ORIGINS=

# バックアップ: 毎日この時刻 (TZ の時刻、0〜23) に取り、この日数より古いものを消す
BACKUP_HOUR=4
BACKUP_KEEP_DAYS=14
TZ=Asia/Tokyo

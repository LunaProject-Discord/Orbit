# 本番 (Oracle Cloud) 用の設定。deploy/setup.sh がこのファイルから deploy/.env を作る。
# 手順は docs/deploy-oracle-cloud.md を参照。

# 公開するドメイン (https:// は付けない)。Web も API もこのドメインで公開する
DOMAIN=orbit.example.com

# 外への公開のしかた (deploy/setup.sh の 2 つ目の引数で決まる)
#   compose.yml:compose.relay.yml   別のサーバー (中継用のサーバー) から逆プロキシする (サーバーの間は HTTPS)
#   compose.yml:compose.proxy.yml   同じサーバーの Web サーバー (Apache など) から逆プロキシする (HTTP)
#   compose.yml:compose.caddy.yml   Caddy が 80 / 443 番で直接公開する
COMPOSE_FILE=compose.yml:compose.proxy.yml
# 逆プロキシする場合に、web が待ち受けるアドレスとポート。
#   127.0.0.1  同じサーバーの Web サーバー (Apache など) から繋ぐ
#   0.0.0.0    別のサーバー (中継用のサーバー) から直接繋ぐ。クラウド側のファイアウォールで接続元を絞ること
#              (compose.proxy.yml のままだと平文の HTTP が外を通るので、compose.relay.yml と組み合わせること)
LOCAL_BIND=127.0.0.1
LOCAL_PORT=18080

# 下の 3 つと VAPID の鍵は deploy/setup.sh が自動で生成する
# PostgreSQL のパスワード。最初の起動後に変えても DB 側には反映されない
POSTGRES_PASSWORD=
# ログインセッションの署名に使う秘密の値
BETTER_AUTH_SECRET=
# メールアカウントの認証情報を暗号化する鍵 (base64 の 32 バイト)。
# 失うと保存済みの認証情報を復号できなくなるので、サーバーの外にも控えておくこと
CREDENTIALS_ENCRYPTION_KEY=

# Microsoft アカウント (Exchange Online / Outlook.com) の追加。空のままなら無効。
# Entra のアプリ登録のリダイレクト URI は https://<DOMAIN>/oauth/microsoft にする
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Gmail アカウントの追加 (Google でログイン)。空のままなら無効。
# OAuth クライアントの「承認済みのリダイレクト URI」は https://<DOMAIN>/oauth/google にする
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 新着メールの通知 (Web Push) に使う鍵の組 (自動生成)。空のままなら、画面を開いている間だけ通知する。
# 変えると、端末で通知を許可し直す必要がある
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# スマホアプリ (Android) への新着メールの通知 (FCM)。空のままなら送らない。
# Firebase コンソールで発行したサービスアカウントの秘密鍵 (JSON) を、base64 で 1 行にした値
# (手順は docs/android-app.md を参照)
FCM_SERVICE_ACCOUNT=

# Orbit 自身が利用者へ送るメール (パスワードの再設定、メールアドレスの変更の確認) の送信用 SMTP サーバー。
# 空のままなら、再設定とメールアドレスの変更は使えない (手順は docs/deploy-oracle-cloud.md の「利用者へ送るメール」)
SYSTEM_MAIL_HOST=
# 既定は 587 (STARTTLS)。465 なら最初から TLS。Oracle Cloud は 25 番の送信を止めているので使わない
SYSTEM_MAIL_PORT=587
SYSTEM_MAIL_USER=
SYSTEM_MAIL_PASSWORD=
# 差出人。"Orbit <no-reply@example.com>" の形でもよい
SYSTEM_MAIL_FROM=

# Microsoft 365 のメールボックスから送る場合 (Microsoft Graph)。SMTP (SYSTEM_MAIL_HOST) とは、どちらか一方だけを書く。
# アプリ登録に Mail.Send の「アプリケーションの許可」と管理者の同意が要る (手順は docs/deploy-oracle-cloud.md)
# 差出人のメールボックス
SYSTEM_MAIL_GRAPH_SENDER=
# テナント (ディレクトリ) の ID かドメイン (common は使えない)
SYSTEM_MAIL_GRAPH_TENANT=
# 空なら MICROSOFT_CLIENT_ID / MICROSOFT_CLIENT_SECRET を使う
SYSTEM_MAIL_GRAPH_CLIENT_ID=
SYSTEM_MAIL_GRAPH_CLIENT_SECRET=

# Web 以外から API を使うときに許可するオリジン (カンマ区切り)。
# スマホアプリとデスクトップ版のオリジンは最初から許可しているので、足す必要はない。
EXTRA_ALLOWED_ORIGINS=

# バックアップ: 毎日この時刻 (TZ の時刻、0〜23) に取り、この日数より古いものを消す
BACKUP_HOUR=4
BACKUP_KEEP_DAYS=14
# バックアップを暗号化する公開鍵 (bash deploy/backup-key.sh が作って書き込む)。空のままなら暗号化せずに書き出す。
# 対になる秘密鍵はサーバーには置かない。失うと、暗号化したバックアップは戻せなくなる
BACKUP_PUBLIC_KEY=
TZ=Asia/Tokyo

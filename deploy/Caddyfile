# Web (静的ファイル) と API へ振り分ける。待ち受け方は SITE_ADDRESS で決まる。
#   同じサーバーの Web サーバー (Apache など) の後ろに置く場合: ":80"。HTTP のまま受け、HTTPS は手前の Web サーバーに任せる
#   別のサーバー (中継用のサーバー) の後ろに置く場合: ":443" と、SITE_TLS に中継用の証明書 (compose.relay.yml)。
#     サーバーの間はインターネットを通るので、HTTPS で受ける
#   Caddy が直接公開する場合: ドメイン名。証明書を Let's Encrypt から自動で取得・更新する
#     (80 番と 443 番が外から届く必要がある)
{$SITE_ADDRESS} {
	# 中継用の証明書を使う場合だけ "tls <証明書> <鍵>" が入る。ほかの構成では空。
	{$SITE_TLS}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API。SSE (/v1/events) と Microsoft Graph の変更通知 (/v1/webhooks/microsoft) もここを通る。
	@api path /v1 /v1/* /healthz
	handle @api {
		# 手前に nginx などの逆プロキシがあっても、変更の通知 (SSE) をため込まずにすぐ流してもらう。
		@events path /v1/events
		header @events X-Accel-Buffering "no"

		reverse_proxy api:8787
	}

	# アプリの画面の自動更新で取得するファイル (docs/app-update.md)。中身は Web と同じファイルだが、
	# HTML として配信すると Cloudflare などの途中のサービスがスクリプトを差し込み、一覧の SHA-256 と
	# 一致しなくなる。HTML として扱われないよう、種類を application/octet-stream にして配信する。
	handle_path /app-update/files/* {
		root * /srv
		header {
			Content-Type application/octet-stream
			Cache-Control "no-cache, no-transform"
			defer
		}
		file_server
	}

	# アプリ本体 (デスクトップ版のインストーラー、Android の APK) の配布 (docs/updates.md)。
	# どの版を配るかは API (/v1/app-update/*) が決め、ここはファイルを渡すだけ。
	handle_path /app-update/releases/* {
		root * /data/app-releases
		header {
			Content-Type application/octet-stream
			Cache-Control "public, max-age=86400, no-transform"
			X-Content-Type-Options "nosniff"
			defer
		}
		file_server
	}

	# Web。Next.js の静的エクスポートなので、/login は login.html を返す。
	# 画面はパス (/mail/accounts/<ID>、/calendar/week/<日付>、/settings/<分類>/<ページ> など) を
	# ブラウザー側で読み取る (以前の /accounts/… なども、画面が /mail/… に書き換える) ので、
	# 対応するファイルの無いパスには最初の画面 (index.html) を返す。
	# 拡張子の付いたパス (スクリプトや画像) は対象にせず、無ければ 404 にする。
	handle {
		root * /srv
		encode zstd gzip

		@immutable path /_next/static/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		# アプリの画面の自動更新の一覧 (docs/app-update.md)。配置のたびに変わるので、毎回確かめさせる。
		@appUpdate path /app-update/*
		header @appUpdate Cache-Control "no-cache"

		@page {
			not path_regexp \.[A-Za-z0-9]+$
			file {
				try_files {path} {path}.html {path}/index.html /index.html
			}
		}
		rewrite @page {file_match.relative}
		file_server
	}

	handle_errors {
		@notFound expression `{err.status_code} == 404`
		handle @notFound {
			root * /srv
			rewrite * /404.html
			file_server
		}
	}
}

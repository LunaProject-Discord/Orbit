# 独自ドメインで HTTPS を受け、Web (静的ファイル) と API へ振り分ける。
# 証明書は Caddy が Let's Encrypt から自動で取得・更新する (80 番と 443 番が外から届く必要がある)。
{$DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API。SSE (/v1/events) と Microsoft Graph の変更通知 (/v1/webhooks/microsoft) もここを通る。
	@api path /v1 /v1/* /healthz
	handle @api {
		reverse_proxy api:8787
	}

	# Web。Next.js の静的エクスポートなので、/login は login.html を返す。
	# メールの画面はパス (/accounts/<ID>/folders/<ID> など) をブラウザー側で読み取るので、
	# 対応するファイルの無いパスには最初の画面 (index.html) を返す。
	# 拡張子の付いたパス (スクリプトや画像) は対象にせず、無ければ 404 にする。
	handle {
		root * /srv
		encode zstd gzip

		@immutable path /_next/static/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@page {
			not path_regexp \.[A-Za-z0-9]+$
			file {
				try_files {path} {path}.html {path}/index.html /index.html
			}
		}
		rewrite @page {file_match.relative}
		file_server
	}

	handle_errors {
		@notFound expression `{err.status_code} == 404`
		handle @notFound {
			root * /srv
			rewrite * /404.html
			file_server
		}
	}
}

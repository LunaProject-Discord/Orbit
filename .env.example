# PostgreSQL (docker compose up -d で起動するローカル DB)
POSTGRES_USER=mail
POSTGRES_PASSWORD=mail
POSTGRES_DB=mail
DATABASE_URL=postgres://mail:mail@localhost:5432/mail

# API サーバー
API_PORT=8787
# Web (Next.js) から見た API の URL
NEXT_PUBLIC_API_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:3000
# 外から見た API の URL (本番では https://api.example.com など)。
# 公開された HTTPS の URL にすると、Microsoft Graph の変更通知 (Webhook) を自動で使う
API_PUBLIC_URL=http://localhost:8787

# 下の 2 つは `pnpm env:init` で自動生成できる (手動なら `openssl rand -base64 32`)
# ログインセッションの署名に使う秘密の値
BETTER_AUTH_SECRET=
# メールアカウントの認証情報を暗号化する鍵 (base64 の 32 バイト)。
# 失うと保存済みの認証情報を復号できなくなるので、安全な場所に控えておくこと
CREDENTIALS_ENCRYPTION_KEY=
# localhost や内部 IP のメールサーバーを登録でき、TLS の無い SMTP にも接続できるようにする (開発用。本番では false)
ALLOW_PRIVATE_MAIL_HOSTS=false

# Microsoft アカウント (Exchange Online / Outlook.com) の追加。空のままなら無効。
# Microsoft Entra 管理センターでアプリを登録して取得する (手順は README を参照)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common (組織 + 個人) / organizations (組織のみ) / consumers (個人のみ) / テナント ID
MICROSOFT_TENANT=common
# ログイン後に戻る Web の URL。アプリ登録のリダイレクト URI と完全に一致させる
MICROSOFT_REDIRECT_URI=http://localhost:3000/oauth/microsoft

# Gmail アカウントの追加 (Google でログイン)。空のままなら無効。
# Google Cloud コンソールで OAuth クライアント (ウェブ アプリケーション) を作って取得する (手順は README を参照)。
# api と worker の両方が読む
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ログイン後に戻る Web の URL。OAuth クライアントの「承認済みのリダイレクト URI」と完全に一致させる
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google

# 添付ファイルの置き場 (送信するファイルと、受信メールから取得した添付の一時的な写し)。
# API サーバーと同期ワーカーの両方から見える場所にする。
# 空のままなら、リポジトリ直下の data/attachments
ATTACHMENTS_DIR=

# 新着メールの通知 (Web Push)。鍵の組は `pnpm env:init` で自動生成できる。
# 空のままなら Web Push は送らず、画面を開いている間だけ通知する
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# プッシュサービス (Google、Mozilla、Apple など) が運営者へ連絡するための宛先。
# mailto: のメールアドレスか https:// の URL。本番では自分の連絡先にする
VAPID_SUBJECT=mailto:admin@localhost

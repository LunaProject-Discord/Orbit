# PostgreSQL (docker compose up -d で起動するローカル DB)
POSTGRES_USER=mail
POSTGRES_PASSWORD=mail
POSTGRES_DB=mail
DATABASE_URL=postgres://mail:mail@localhost:5432/mail

# API サーバー
API_PORT=8787
# Web (Next.js) から見た API の URL
NEXT_PUBLIC_API_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:3000
# 外から見た API の URL (本番では https://api.example.com など)
API_PUBLIC_URL=http://localhost:8787

# 下の 2 つは `pnpm env:init` で自動生成できる (手動なら `openssl rand -base64 32`)
# ログインセッションの署名に使う秘密の値
BETTER_AUTH_SECRET=
# メールアカウントの認証情報を暗号化する鍵 (base64 の 32 バイト)。
# 失うと保存済みの認証情報を復号できなくなるので、安全な場所に控えておくこと
CREDENTIALS_ENCRYPTION_KEY=
# localhost や内部 IP のメールサーバーを登録できるようにする (開発用。本番では false)
ALLOW_PRIVATE_MAIL_HOSTS=false

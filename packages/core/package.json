{
  "name": "@orbit/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "mail-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./recurrence": {
      "mail-source": "./src/recurrence.ts",
      "types": "./dist/recurrence.d.ts",
      "default": "./dist/recurrence.js"
    },
    "./event-merge": {
      "mail-source": "./src/event-merge.ts",
      "types": "./dist/event-merge.d.ts",
      "default": "./dist/event-merge.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "rrule-temporal": "2.3.0",
    "temporal-polyfill": "1.0.8",
    "tldts": "^7.6.1",
    "undici": "7.30.2"
  }
}
